rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - authenticated users can read/write their own data
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Chats - only participants can read/write
    match /chats/{chatId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;

      match /messages/{msgId} {
        allow read, write: if request.auth != null;
      }
    }

    // Friends collection
    match /friends/{docId} {
      allow read, write: if request.auth != null;
    }

    // Friend requests
    match /friendRequests/{docId} {
      allow read, write: if request.auth != null;
    }

    // Push notification queue - authenticated users write, public read for Cloudflare Worker
    match /pushQueue/{docId} {
      allow create: if request.auth != null;
      allow read, delete: if true; // Cloudflare Worker reads & deletes (uses API key, no auth)
    }
  }
}
